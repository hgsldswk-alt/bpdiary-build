    },
    "这是您自己的口令，无需导入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您自己的口令，无需导入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
