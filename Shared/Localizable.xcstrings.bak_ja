    "30 天从首次打开起计算，领取或恢复凭证不会重新开始试用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天从首次打开起计算，领取或恢复凭证不会重新开始试用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30 days begin when you first open the app. Claiming or restoring a receipt does not restart the trial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天從首次打開起計算，領取或恢復憑證不會重新開始試用。"
          }
        }
      }
    },
    "AHA/ACC：正常 <120 且 <80；正常高值 120–129 且 <80；1 级 130–139 或 80–89；2 级 ≥140 或 ≥90；≥180 或 >120 需关注。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AHA/ACC：正常 <120 且 <80；正常高值 120–129 且 <80；1 级 130–139 或 80–89；2 级 ≥140 或 ≥90；≥180 或 >120 需关注。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AHA/ACC: Normal <120 and <80; Elevated 120–129 and <80; Stage 1 130–139 or 80–89; Stage 2 ≥140 or ≥90. Readings ≥180 or >120 need attention."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AHA/ACC：正常 <120 且 <80；正常高值 120–129 且 <80；1 級 130–139 或 80–89；2 級 ≥140 或 ≥90；≥180 或 >120 需關注。"
          }
        }
      }
    },
