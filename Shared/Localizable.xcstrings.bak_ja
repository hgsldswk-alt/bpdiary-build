    "个人目标以 0.1 mmol/L 为单位填写，例如 61 表示 6.1。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人目标以 0.1 mmol/L 为单位填写，例如 61 表示 6.1。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter personal targets in tenths of mmol/L. For example, 61 means 6.1."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人目標以 0.1 mmol/L 為單位填寫，例如 61 表示 6.1。"
          }
        }
      }
    },
