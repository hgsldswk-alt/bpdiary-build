    "家庭记录平均达到 135/85 时请与医生讨论。分级仅供参考。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭记录平均达到 135/85 时请与医生讨论。分级仅供参考。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuss home averages of 135/85 or higher with your doctor. Categories are for reference only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭記錄平均達到 135/85 時請與醫生討論。分級僅供參考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭での平均が135/85以上の場合は、医師に相談してください。区分は参考用です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besprich Durchschnittswerte zu Hause ab 135/85 mit deinem Arzt. Kategorien dienen nur als Orientierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenta con tu médico los promedios en casa de 135/85 o más. Las categorías son solo de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à votre médecin des moyennes à domicile de 135/85 ou plus. Les catégories sont données à titre indicatif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse com seu médico sobre médias em casa de 135/85 ou mais. As categorias são apenas referência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con il medico se la media a casa è 135/85 o più. Le categorie sono solo indicative."
          }
        }
      }
    },
    "家里还有谁要记？": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里还有谁要记？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would anyone else in your family like a profile?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家里還有誰要記？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの家族のプロフィールも作りますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchte noch jemand in deiner Familie ein Profil?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Alguien más de tu familia quiere un perfil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre dans la famille veut un profil ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alguém da família quer um perfil?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro in famiglia vuole un profilo?"
          }
        }
      }
    },
    "导入后成为只读家人。同来源新口令覆盖更新，不影响本机其他家人。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入后成为只读家人。同来源新口令覆盖更新，不影响本机其他家人。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported profiles are read-only. A new code from the same source updates that profile without changing your other family records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入后成為只讀家人。同來源新口令覆蓋更新，不影響本機其他家人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込んだプロフィールは閲覧のみです。同じ送り主からの新しいコードでそのプロフィールが更新され、ほかの家族の記録は変わりません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Profile sind schreibgeschützt. Ein neuer Code aus derselben Quelle aktualisiert dieses Profil, ohne deine anderen Familieneinträge zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles importados son de solo lectura. Un código nuevo de la misma fuente actualiza ese perfil sin cambiar tus otros registros familiares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils importés sont en lecture seule. Un nouveau code de la même source met à jour ce profil sans changer vos autres relevés familiaux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis importados são só leitura. Um novo código da mesma origem atualiza esse perfil sem mudar seus outros registros familiares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili importati sono di sola lettura. Un nuovo codice dalla stessa fonte aggiorna quel profilo senza toccare gli altri dati della famiglia."
          }
        }
      }
    },
    "导入完成，重复记录已跳过。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入完成，重复记录已跳过。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import complete. Duplicate records were skipped."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入完成，重復記錄已跳過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みが完了しました。重複した記録はスキップしました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import fertig. Doppelte Einträge wurden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importación completa. Se omitieron los registros duplicados."
          }
        },
        "fr": {
