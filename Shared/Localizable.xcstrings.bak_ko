    "个人目标以 0.1 mmol/L 为单位填写，例如 61 表示 6.1。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人目标以 0.1 mmol/L 为单位填写，例如 61 表示 6.1。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter personal targets in tenths of mmol/L. For example, 61 means 6.1."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人目標以 0.1 mmol/L 為單位填寫，例如 61 表示 6.1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の目標値は0.1 mmol/L単位で入力します。例：61は6.1です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib persönliche Ziele in Zehnteln mmol/L ein. 61 bedeutet z. B. 6,1."
