    "ESH 2023：理想 <120 且 <80；正常 120–129 或 80–84；正常高值 130–139 或 85–89；1 级 140–159 或 90–99；2 级 160–179 或 100–109；3 级 ≥180 或 ≥110。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023：理想 <120 且 <80；正常 120–129 或 80–84；正常高值 130–139 或 85–89；1 级 140–159 或 90–99；2 级 160–179 或 100–109；3 级 ≥180 或 ≥110。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023: Optimal <120 and <80; Normal 120–129 or 80–84; High normal 130–139 or 85–89; Grade 1 140–159 or 90–99; Grade 2 160–179 or 100–109; Grade 3 ≥180 or ≥110."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023：理想 <120 且 <80；正常 120–129 或 80–84；正常高值 130–139 或 85–89；1 級 140–159 或 90–99；2 級 160–179 或 100–109；3 級 ≥180 或 ≥110。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023：至適 <120 かつ <80、正常 120–129 または 80–84、正常高値 130–139 または 85–89、I度 140–159 または 90–99、II度 160–179 または 100–109、III度 ≥180 または ≥110。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023: Optimal <120 und <80; Normal 120–129 oder 80–84; Hoch normal 130–139 oder 85–89; Grad 1 140–159 oder 90–99; Grad 2 160–179 oder 100–109; Grad 3 ≥180 oder ≥110."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023: Óptima <120 y <80; Normal 120–129 u 80–84; Normal alta 130–139 u 85–89; Grado 1 140–159 o 90–99; Grado 2 160–179 o 100–109; Grado 3 ≥180 o ≥110."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023 : Optimale <120 et <80 ; Normale 120–129 ou 80–84 ; Normale haute 130–139 ou 85–89 ; Grade 1 140–159 ou 90–99 ; Grade 2 160–179 ou 100–109 ; Grade 3 ≥180 ou ≥110."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023: Ótima <120 e <80; Normal 120–129 ou 80–84; Normal alta 130–139 ou 85–89; Grau 1 140–159 ou 90–99; Grau 2 160–179 ou 100–109; Grau 3 ≥180 ou ≥110."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ESH 2023: Ottimale <120 e <80; Normale 120–129 o 80–84; Normale-alta 130–139 o 85–89; Grado 1 140–159 o 90–99; Grado 2 160–179 o 100–109; Grado 3 ≥180 o ≥110."
          }
        }
