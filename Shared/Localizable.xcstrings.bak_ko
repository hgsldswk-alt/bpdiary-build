    "中国 2024：正常 <120 且 <80；正常高值 120–139 或 80–89；1 级 140–159 或 90–99；2 级 160–179 或 100–109；3 级 ≥180 或 ≥110。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国 2024：正常 <120 且 <80；正常高值 120–139 或 80–89；1 级 140–159 或 90–99；2 级 160–179 或 100–109；3 级 ≥180 或 ≥110。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "China 2024: Normal <120 and <80; High normal 120–139 or 80–89; Grade 1 140–159 or 90–99; Grade 2 160–179 or 100–109; Grade 3 ≥180 or ≥110."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中國 2024：正常 <120 且 <80；正常高值 120–139 或 80–89；1 級 140–159 或 90–99；2 級 160–179 或 100–109；3 級 ≥180 或 ≥110。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国 2024：正常 <120 かつ <80、正常高値 120–139 または 80–89、I度 140–159 または 90–99、II度 160–179 または 100–109、III度 ≥180 または ≥110。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "China 2024: Normal <120 und <80; Hoch normal 120–139 oder 80–89; Grad 1 140–159 oder 90–99; Grad 2 160–179 oder 100–109; Grad 3 ≥180 oder ≥110."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "China 2024: Normal <120 y <80; Normal alta 120–139 u 80–89; Grado 1 140–159 o 90–99; Grado 2 160–179 o 100–109; Grado 3 ≥180 o ≥110."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chine 2024 : Normale <120 et <80 ; Normale haute 120–139 ou 80–89 ; Grade 1 140–159 ou 90–99 ; Grade 2 160–179 ou 100–109 ; Grade 3 ≥180 ou ≥110."
