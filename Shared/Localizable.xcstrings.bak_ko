    "本 App 是记录工具，不能测量血压，记录和分级仅供日常参考。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 是记录工具，不能测量血压，记录和分级仅供日常参考。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a diary. It cannot measure blood pressure. Records and categories are for everyday reference only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 是記錄工具，不能測量血壓，記錄與分級僅供日常參考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは記録用の手帳です。血圧を測定することはできません。記録と区分は日常の参考用です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist ein Tagebuch. Sie kann keinen Blutdruck messen. Einträge und Kategorien dienen nur zur Orientierung im Alltag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app es un diario. No puede medir la presión arterial. Los registros y categorías son solo de referencia cotidiana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est un carnet. Elle ne peut pas mesurer la tension. Les relevés et catégories sont donnés à titre indicatif."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app é um diário. Ele não mede a pressão. Registros e categorias são apenas referência no dia a dia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è un diario. Non misura la pressione. Dati e categorie sono solo di riferimento quotidiano."
          }
        }
      }
    },
    "本地文件无法读取，已停止写入以保护原始记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件无法读取，已停止写入以保护原始记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local file could not be read. Saving is paused to protect your original records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件無法讀取，已停止寫入以保護原始記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内のファイルを読み込めませんでした。元の記録を守るため保存を一時停止しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datei konnte nicht gelesen werden. Sichern ist pausiert, um deine Originaleinträge zu schützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo local. Se pausó el guardado para proteger tus registros originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier local. L’enregistrement est suspendu pour protéger vos relevés d’origine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo local. O salvamento foi pausado para proteger seus registros originais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file locale. Il salvataggio è sospeso per proteggere i dati originali."
          }
        }
      }
    },
    "本报表由用户自行记录，仅供医生参考。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本报表由用户自行记录，仅供医生参考。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These readings were entered by the user and are for the doctor's reference only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本報表由用戶自行記錄，僅供醫生參考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの数値はユーザーが入力したもので、医師の参考用です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte wurden vom Nutzer eingetragen und dienen dem Arzt nur zur Orientierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas lecturas las introdujo el usuario y son solo de referencia para el médico."
          }
        },
        "fr": {
          "stringUnit": {
