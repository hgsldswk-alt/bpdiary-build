    "这是您自己的口令，无需导入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您自己的口令，无需导入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own family code. There is no need to import it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是您自己的口令，無需導入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた自身の家族コードです。取り込む必要はありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein eigener Familiencode. Du musst ihn nicht importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es tu propio código familiar. No hace falta importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre propre code familial. Inutile de l’importer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu próprio código familiar. Não precisa importar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il tuo codice famiglia. Non serve importarlo."
          }
        }
      }
    },
    "连测同组先取平均，统计按次计算；正数平均四舍五入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连测同组先取平均，统计按次计算；正数平均四舍五入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readings in one session are averaged first. Statistics count sessions. Positive averages round half up."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連測同組先取平均，統計按次計算；正數平均四舍五入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の測定内の値をまず平均し、統計は測定回数で数えます。平均は四捨五入です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte einer Messung werden zuerst gemittelt. Die Statistik zählt Messungen. Positive Durchschnitte werden kaufmännisch gerundet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lecturas de una toma se promedian primero. Las estadísticas cuentan tomas. Los promedios positivos se redondean hacia arriba desde ,5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures d’une séance sont d’abord moyennées. Les statistiques comptent les séances. Les moyennes positives sont arrondies au plus proche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras de uma medição são promediadas primeiro. As estatísticas contam medições. Médias positivas são arredondadas para cima a partir de ,5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misurazioni di una sessione vengono prima mediate. Le statistiche contano le sessioni. Le medie positive si arrotondano per eccesso da 0,5."
          }
        }
      }
    },
    "连续记录建议间隔 1 分钟；同组明细保留，统计取平均。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续记录建议间隔 1 分钟；同组明细保留，统计取平均。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow 1 minute between readings. Session details are kept and averaged for statistics."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續記錄建議間隔 1 分鐘；同組明細保留，統計取平均。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定の間は1分あけてください。各回の値は保存され、統計では平均されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte 1 Minute zwischen den Werten. Details der Messung bleiben erhalten und werden für die Statistik gemittelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja 1 minuto entre lecturas. Los detalles de la toma se guardan y se promedian para las estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez 1 minute entre les mesures. Le détail de la séance est conservé et moyenné pour les statistiques."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere 1 minuto entre as leituras. Os detalhes da medição são guardados e promediados nas estatísticas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia 1 minuto tra le misurazioni. I dettagli della sessione restano e vengono mediati nelle statistiche."
          }
        }
      }
    },
    "通知不含读数。系统最多保留 64 条待发通知，打开 App 会滚动更新未来 30 天计划。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知不含读数。系统最多保留 64 条待发通知，打开 App 会滚动更新未来 30 天计划。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications contain no readings. iOS allows up to 64 pending alerts. Opening the app updates the rolling 30-day schedule."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知不含讀數。系統最多保留 64 條待發通知，打開 App 會滾動更新未來 30 天計劃。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知に数値は含まれません。iOSで予約できる通知は64件までです。アプリを開くと30日分の予定が更新されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen enthalten keine Werte. iOS erlaubt bis zu 64 geplante Hinweise. Beim Öffnen der App wird der 30-Tage-Plan erneuert."
          }
        },
        "es": {
          "stringUnit": {
