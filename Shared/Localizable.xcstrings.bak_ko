          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non contengono valori. iOS consente fino a 64 avvisi in attesa. Aprire l’app aggiorna la programmazione dei prossimi 30 giorni."
          }
        }
      }
    },
