    "记录保存在本机，不收集数据。请使用 iPhone 备份或导出 CSV 保存副本。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录保存在本机，不收集数据。请使用 iPhone 备份或导出 CSV 保存副本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay on this device. No data is collected. Use iPhone backups or export CSV to keep a copy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄保存在本機，不收集數據。請使用 iPhone 備份或導出 CSV 保存副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末内に保存されます。データは一切収集しません。コピーを残すにはiPhoneのバックアップかCSV書き出しを使ってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge bleiben auf diesem Gerät. Es werden keine Daten gesammelt. Nutze iPhone-Backups oder CSV-Export für eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros se quedan en este dispositivo. No se recogen datos. Usa las copias de seguridad del iPhone o exporta CSV para guardar una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les relevés restent sur cet appareil. Aucune donnée n’est collectée. Utilisez les sauvegardes de l’iPhone ou l’export CSV pour garder une copie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros ficam neste aparelho. Nenhum dado é coletado. Use backups do iPhone ou exporte CSV para guardar uma cópia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati restano su questo dispositivo. Nessun dato raccolto. Usa il backup dell’iPhone o esporta in CSV per tenerne una copia."
          }
        }
      }
    },
