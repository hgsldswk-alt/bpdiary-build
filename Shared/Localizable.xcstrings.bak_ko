    "高压 %@、低压 %@。请核对血压计上的数值。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高压 %@、低压 %@。请核对血压计上的数值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top number %@, bottom number %@. Please check the numbers on your monitor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高壓 %@、低壓 %@。請核對血壓計上的數值。"
