    "健康同步已完成；读取权限由系统保护。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康同步已完成；读取权限由系统保护。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health sync finished. Read permission is protected by the system."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康同步已完成；讀取權限由系統保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアとの同期が完了しました。読み取り許可はシステムで保護されています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-Synchronisierung fertig. Die Leseberechtigung wird vom System geschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización con Salud terminada. El permiso de lectura está protegido por el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation avec Santé terminée. L’autorisation de lecture est protégée par le système."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização com o Saúde concluída. A permissão de leitura é protegida pelo sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione con Salute completata. Il permesso di lettura è protetto dal sistema."
          }
        }
      }
    },
    "健康未授权或同步失败。去 设置 > 健康 > 数据访问 打开；本地记录不受影响。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康未授权或同步失败。去 设置 > 健康 > 数据访问 打开；本地记录不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health access is unavailable or sync failed. Open Settings > Health > Data Access to allow access. Your local records still work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康未授權或同步失敗。去 設置 > 健康 > 數據訪問 打開；本地記錄不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアにアクセスできないか、同期に失敗しました。「設定」>「ヘルスケア」>「データアクセス」で許可してください。端末内の記録はそのまま使えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-Zugriff nicht verfügbar oder Synchronisierung fehlgeschlagen. Erlaube den Zugriff unter Einstellungen > Health > Datenzugriff. Deine lokalen Einträge funktionieren weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Salud no está disponible o la sincronización falló. Abre Ajustes > Salud > Acceso a datos para permitirlo. Tus registros locales siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Santé est indisponible ou la synchronisation a échoué. Ouvrez Réglages > Santé > Accès aux données pour l’autoriser. Vos données locales fonctionnent toujours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao Saúde não está disponível ou a sincronização falhou. Abra Ajustes > Saúde > Acesso a Dados para permitir. Seus registros locais continuam funcionando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso a Salute non disponibile o sincronizzazione non riuscita. Apri Impostazioni > Salute > Accesso ai dati per consentirlo. I dati locali funzionano comunque."
          }
        }
      }
    },
