    "WHO 血糖参考：空腹 6.1 / 7.0，餐后两小时 7.8 / 11.1 mmol/L；其他时段不分级。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 血糖参考：空腹 6.1 / 7.0，餐后两小时 7.8 / 11.1 mmol/L；其他时段不分级。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO glucose reference: fasting 6.1 / 7.0, two hours after meals 7.8 / 11.1 mmol/L. Other times are not graded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 血糖參考：空腹 6.1 / 7.0，餐后兩小時 7.8 / 11.1 mmol/L；其他時段不分級。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOの血糖の参考値：空腹時 6.1 / 7.0、食後2時間 7.8 / 11.1 mmol/L。それ以外の時間帯は区分しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO-Referenz Blutzucker: nüchtern 6,1 / 7,0, zwei Stunden nach dem Essen 7,8 / 11,1 mmol/L. Andere Zeiten werden nicht eingestuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia de glucosa de la OMS: en ayunas 6,1 / 7,0; dos horas después de comer 7,8 / 11,1 mmol/L. Otros momentos no se clasifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Référence glycémie OMS : à jeun 6,1 / 7,0, deux heures après le repas 7,8 / 11,1 mmol/L. Les autres moments ne sont pas classés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Referência de glicemia da OMS: jejum 6,1 / 7,0; duas horas após a refeição 7,8 / 11,1 mmol/L. Outros horários não são classificados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riferimento OMS per la glicemia: a digiuno 6,1 / 7,0, due ore dopo i pasti 7,8 / 11,1 mmol/L. Gli altri momenti non sono classificati."
          }
        }
      }
    },
    "一次购买，不自动续费。试用期已有家人与提醒到期后继续可用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，不自动续费。试用期已有家人与提醒到期后继续可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase, no automatic renewal. Family profiles and reminders created during the trial remain available afterward."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，不自動續費。試用期已有家人與提醒到期后繼續可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、自動更新はありません。お試し期間中に作った家族のプロフィールと通知は、その後も使えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf, keine automatische Verlängerung. Familienprofile und Erinnerungen aus der Testphase bleiben danach erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago, sin renovación automática. Los perfiles familiares y recordatorios creados en la prueba se mantienen después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat, sans renouvellement automatique. Les profils familiaux et rappels créés pendant l’essai restent disponibles ensuite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra, sem renovação automática. Perfis familiares e lembretes criados no teste continuam disponíveis depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto, nessun rinnovo automatico. Profili familiari e promemoria creati durante la prova restano disponibili dopo."
          }
        }
      }
    },
    "下一项": {
