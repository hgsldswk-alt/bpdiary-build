    "免费体验共 30 天，从首次打开本版本起算，恢复后沿用原来的到期时间。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费体验共 30 天，从首次打开本版本起算，恢复后沿用原来的到期时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30-day free trial starts the first time you open this version. Restoring keeps the original end date."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費體驗共 30 天，從首次開啟本版本起算，恢復後沿用原來的到期時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間の無料お試しは、このバージョンを初めて開いた日から始まります。復元しても元の終了日は変わりません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 30-tägige kostenlose Testphase beginnt beim ersten Öffnen dieser Version. Wiederherstellen behält das ursprüngliche Enddatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratis de 30 días empieza la primera vez que abres esta versión. Restaurar mantiene la fecha de fin original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit de 30 jours commence à la première ouverture de cette version. La restauration garde la date de fin d’origine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis de 30 dias começa na primeira abertura desta versão. Restaurar mantém a data final original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita di 30 giorni inizia alla prima apertura di questa versione. Il ripristino mantiene la data di fine originale."
          }
        }
      }
    },
