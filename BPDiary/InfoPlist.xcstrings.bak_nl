    "NSHealthShareUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本机主人的健康记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the phone owner's health records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取本機主人的健康記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の持ち主のヘルスケアの記録を読み取ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die Gesundheitsdaten des iPhone-Besitzers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los registros de salud del dueño del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les données de santé du propriétaire du téléphone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os registros de saúde do dono do celular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i dati di salute del proprietario dell’iPhone."
          }
